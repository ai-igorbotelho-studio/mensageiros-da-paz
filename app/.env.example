# Copie este arquivo para .env e preencha com as credenciais reais do
# projeto Firebase (Console Firebase > Configurações do projeto > Geral >
# apps > SDK setup). Estas chaves "web" do Firebase são públicas por design
# (não são segredos de servidor), mas ainda assim NUNCA commite o .env real
# neste repositório — mantenha só este .env.example com placeholders.

EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_ME

# Necessários apenas para o build nativo (EAS Build), não usados em runtime:
# app/GoogleService-Info.plist (iOS) — baixar do console Firebase
# app/google-services.json (Android) — baixar do console Firebase
